# ─────────────────────────────────────────────
#  Bangladesh Medical Voice Assistant — .env
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Google / Gemini ───────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# ── Google STT / TTS ─────────────────────────
STT_LANGUAGE_CODE=bn-BD
STT_MODEL=latest_long
TTS_LANGUAGE_CODE=bn-BD
TTS_VOICE_NAME=bn-BD-Standard-A
TTS_SPEAKING_RATE=0.95
TTS_PITCH=0.0

# ── Twilio ────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+8801XXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_assistant
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# ── OTP Auth ─────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
JWT_SECRET=change-me-to-another-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── bKash (Payment Gateway) ───────────────────
# Register at: https://developer.bka.sh/
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password

# ── SMS Gateway ───────────────────────────────
# Primary: Twilio SMS (uses TWILIO_* above)
# Fallback: SSL Wireless (local BD provider)
SSL_WIRELESS_API_URL=http://sms.sslwireless.com/pushapi/dynamic/server.php
SSL_WIRELESS_USER=your-ssl-wireless-user
SSL_WIRELESS_PASS=your-ssl-wireless-password
SSL_WIRELESS_SID=your-sender-id

# ── Prayer Times API ──────────────────────────
# Free API — no key needed
ALADHAN_API_URL=https://api.aladhan.com/v1
DEFAULT_CITY=Dhaka
DEFAULT_COUNTRY=Bangladesh

# ── App Server ────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
WEBHOOK_BASE_URL=https://your-ngrok-or-domain.com
